{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Docker Debug",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "port": 5678,
        "host": "localhost"
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
        }
      ]
    },
    {
      "name": "Celery: Docker Debug",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "port": 6900,
        "host": "localhost"
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
        }
      ]
    }
  ]
}
